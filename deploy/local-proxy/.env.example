# Copy to `.env` in this directory (deploy/local-proxy/) and fill in. Git-ignored — no real secrets.

# Tailscale auth key (admin console → Settings → Keys → Generate auth key).
# An ephemeral/reusable key is fine; the node registers as `dcm-local-proxy`.
TS_AUTHKEY=

# Your Anthropic /v1/messages-compatible proxy image. It MUST listen on :8787 inside the container
# and handle both MODEL and INGEST_MODEL that the bot sends.
PROXY_IMAGE=

# --- Your proxy's own settings (loaded into the `proxy` service via env_file) ---
# Whatever upstream credentials / model mapping your proxy needs. Consult its docs. Example:
# ANTHROPIC_AUTH_TOKEN=
# PORT=8787
